{
  "components": {
    "schemas": {
      "DurationDays": {
        "description": "Mission duration allowlist. Values outside it are a 422.",
        "enum": [
          7.0,
          14.0,
          29.5
        ],
        "title": "DurationDays",
        "type": "number"
      },
      "EvaluateRequestSchema": {
        "additionalProperties": false,
        "description": "Contract B evaluation request payload (P0: curated sites only).",
        "properties": {
          "duration_days": {
            "$ref": "#/components/schemas/DurationDays",
            "default": 14
          },
          "fixed_array_azimuth_deg": {
            "default": 0.0,
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Fixed Array Azimuth Deg",
            "type": "number"
          },
          "min_comms_elev_deg": {
            "default": 5.0,
            "maximum": 45.0,
            "minimum": -5.0,
            "title": "Min Comms Elev Deg",
            "type": "number"
          },
          "observer_height_m": {
            "$ref": "#/components/schemas/ObserverHeightM",
            "default": 2.0
          },
          "site_id": {
            "title": "Site Id",
            "type": "string"
          },
          "solar_array_type": {
            "$ref": "#/components/schemas/SolarArrayType",
            "default": "vertical_tracking"
          },
          "start_utc": {
            "title": "Start Utc",
            "type": "string"
          },
          "step_minutes": {
            "$ref": "#/components/schemas/StepMinutes",
            "default": 60
          }
        },
        "required": [
          "site_id",
          "start_utc"
        ],
        "title": "EvaluateRequestSchema",
        "type": "object"
      },
      "EvaluateResponseSchema": {
        "description": "Contract B full evaluation response.",
        "properties": {
          "horizon_profile": {
            "items": {
              "$ref": "#/components/schemas/HorizonProfilePointSchema"
            },
            "title": "Horizon Profile",
            "type": "array"
          },
          "site": {
            "$ref": "#/components/schemas/EvaluatedSiteSchema"
          },
          "summary": {
            "$ref": "#/components/schemas/EvaluationSummarySchema"
          },
          "timeseries": {
            "items": {
              "$ref": "#/components/schemas/TimeseriesPointSchema"
            },
            "title": "Timeseries",
            "type": "array"
          }
        },
        "required": [
          "site",
          "summary",
          "horizon_profile",
          "timeseries"
        ],
        "title": "EvaluateResponseSchema",
        "type": "object"
      },
      "EvaluatedSiteSchema": {
        "description": "Site metadata block inside Contract B EvaluateResponse.",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/SiteCategory"
          },
          "elevation_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elevation M"
          },
          "has_precomputed_terrain": {
            "title": "Has Precomputed Terrain",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lat_deg": {
            "title": "Lat Deg",
            "type": "number"
          },
          "lon_deg": {
            "title": "Lon Deg",
            "type": "number"
          },
          "mean_slope_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Slope Deg"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "lat_deg",
          "lon_deg",
          "has_precomputed_terrain"
        ],
        "title": "EvaluatedSiteSchema",
        "type": "object"
      },
      "EvaluationSummarySchema": {
        "description": "Aggregate mission summary metrics and risk warnings (REQ-09).",
        "properties": {
          "dte_comms_hours": {
            "title": "Dte Comms Hours",
            "type": "number"
          },
          "dte_fraction": {
            "title": "Dte Fraction",
            "type": "number"
          },
          "feasibility_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feasibility Score"
          },
          "longest_comms_blackout_hours": {
            "title": "Longest Comms Blackout Hours",
            "type": "number"
          },
          "longest_dark_streak_hours": {
            "title": "Longest Dark Streak Hours",
            "type": "number"
          },
          "mean_irradiance_w_m2": {
            "title": "Mean Irradiance W M2",
            "type": "number"
          },
          "mean_solar_power_factor": {
            "title": "Mean Solar Power Factor",
            "type": "number"
          },
          "next_events_from_start": {
            "$ref": "#/components/schemas/NextEventsSchema"
          },
          "overlap_fraction": {
            "title": "Overlap Fraction",
            "type": "number"
          },
          "overlap_sun_and_dte_hours": {
            "title": "Overlap Sun And Dte Hours",
            "type": "number"
          },
          "risk_warnings": {
            "items": {
              "type": "string"
            },
            "title": "Risk Warnings",
            "type": "array"
          },
          "sub_scores": {
            "$ref": "#/components/schemas/SubScoresSchema"
          },
          "sunlit_fraction": {
            "title": "Sunlit Fraction",
            "type": "number"
          },
          "sunlit_hours": {
            "title": "Sunlit Hours",
            "type": "number"
          }
        },
        "required": [
          "sub_scores",
          "sunlit_hours",
          "sunlit_fraction",
          "longest_dark_streak_hours",
          "dte_comms_hours",
          "dte_fraction",
          "overlap_sun_and_dte_hours",
          "overlap_fraction",
          "longest_comms_blackout_hours",
          "mean_solar_power_factor",
          "mean_irradiance_w_m2",
          "risk_warnings",
          "next_events_from_start"
        ],
        "title": "EvaluationSummarySchema",
        "type": "object"
      },
      "ExternalLinksSchema": {
        "description": "External NASA mapping deep links centered on a lunar landing site.",
        "properties": {
          "moon_trek_url": {
            "title": "Moon Trek Url",
            "type": "string"
          },
          "quickmap_url": {
            "title": "Quickmap Url",
            "type": "string"
          }
        },
        "required": [
          "quickmap_url",
          "moon_trek_url"
        ],
        "title": "ExternalLinksSchema",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Service liveness plus the reference constants the client may use for layout.",
        "properties": {
          "architecture": {
            "title": "Architecture",
            "type": "string"
          },
          "frame": {
            "title": "Frame",
            "type": "string"
          },
          "moon_radius_km": {
            "title": "Moon Radius Km",
            "type": "number"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "architecture",
          "frame",
          "moon_radius_km"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HorizonProfilePointSchema": {
        "description": "Single azimuth sample of the 360-degree lunar horizon mask.",
        "properties": {
          "azimuth_deg": {
            "title": "Azimuth Deg",
            "type": "number"
          },
          "geometric_limb_deg": {
            "title": "Geometric Limb Deg",
            "type": "number"
          },
          "terrain_elev_deg": {
            "title": "Terrain Elev Deg",
            "type": "number"
          }
        },
        "required": [
          "azimuth_deg",
          "terrain_elev_deg",
          "geometric_limb_deg"
        ],
        "title": "HorizonProfilePointSchema",
        "type": "object"
      },
      "HorizonProfileSchema": {
        "description": "Precomputed 360-degree horizon for one observer height (REQ-08).",
        "properties": {
          "azimuth_deg": {
            "items": {
              "type": "number"
            },
            "maxItems": 360,
            "minItems": 360,
            "title": "Azimuth Deg",
            "type": "array"
          },
          "geometric_limb_deg": {
            "items": {
              "type": "number"
            },
            "maxItems": 360,
            "minItems": 360,
            "title": "Geometric Limb Deg",
            "type": "array"
          },
          "observer_height_m": {
            "$ref": "#/components/schemas/ObserverHeightM"
          },
          "terrain_elev_deg": {
            "items": {
              "type": "number"
            },
            "maxItems": 360,
            "minItems": 360,
            "title": "Terrain Elev Deg",
            "type": "array"
          }
        },
        "required": [
          "observer_height_m",
          "azimuth_deg",
          "terrain_elev_deg",
          "geometric_limb_deg"
        ],
        "title": "HorizonProfileSchema",
        "type": "object"
      },
      "NextEventsSchema": {
        "description": "Hours from mission start until next solar/DTE transition.",
        "properties": {
          "hours_to_earthrise": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Earthrise"
          },
          "hours_to_earthset": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Earthset"
          },
          "hours_to_sunrise": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Sunrise"
          },
          "hours_to_sunset": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Sunset"
          }
        },
        "title": "NextEventsSchema",
        "type": "object"
      },
      "ObserverHeightM": {
        "description": "Observer mast heights; only these three horizon profiles are precomputed.",
        "enum": [
          1.5,
          2.0,
          10.0
        ],
        "title": "ObserverHeightM",
        "type": "number"
      },
      "SiteCategory": {
        "description": "Registry category (REQ-05).",
        "enum": [
          "artemis_iii",
          "clps_commercial",
          "apollo_historic",
          "international"
        ],
        "title": "SiteCategory",
        "type": "string"
      },
      "SiteSummarySchema": {
        "description": "Contract A response item describing a curated lunar landing site (REQ-05).",
        "properties": {
          "agency": {
            "title": "Agency",
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SiteCategory"
          },
          "elevation_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elevation M"
          },
          "external_links": {
            "$ref": "#/components/schemas/ExternalLinksSchema"
          },
          "has_precomputed_terrain": {
            "title": "Has Precomputed Terrain",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lat_deg": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat Deg",
            "type": "number"
          },
          "lon_deg": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon Deg",
            "type": "number"
          },
          "mean_slope_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Slope Deg"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "agency",
          "lat_deg",
          "lon_deg",
          "has_precomputed_terrain",
          "summary",
          "external_links"
        ],
        "title": "SiteSummarySchema",
        "type": "object"
      },
      "SolarArrayType": {
        "description": "Solar array architecture (REQ-09).",
        "enum": [
          "horizontal_fixed",
          "vertical_fixed",
          "vertical_tracking"
        ],
        "title": "SolarArrayType",
        "type": "string"
      },
      "StepMinutes": {
        "description": "Mission sampling step allowlist.",
        "enum": [
          10,
          60
        ],
        "title": "StepMinutes",
        "type": "integer"
      },
      "SubScoresSchema": {
        "description": "Breakdown sub-scores (0-100) for feasibility evaluation.",
        "properties": {
          "comms_score": {
            "title": "Comms Score",
            "type": "number"
          },
          "power_score": {
            "title": "Power Score",
            "type": "number"
          },
          "terrain_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terrain Score"
          },
          "thermal_score": {
            "title": "Thermal Score",
            "type": "number"
          }
        },
        "required": [
          "power_score",
          "thermal_score",
          "comms_score"
        ],
        "title": "SubScoresSchema",
        "type": "object"
      },
      "TerrainPatchSchema": {
        "additionalProperties": false,
        "description": "Contract C ``local_enu`` terrain patch for a LOLA-covered site (REQ-08).\n\n``elevations_m_flat`` and ``slopes_deg_flat`` hold ``grid_size**2`` values,\nflattened as ``index = row * grid_size + column`` with rows running\nsouth-to-north and columns west-to-east.",
        "properties": {
          "center_elevation_m": {
            "title": "Center Elevation M",
            "type": "number"
          },
          "column_direction": {
            "const": "west_to_east",
            "default": "west_to_east",
            "title": "Column Direction",
            "type": "string"
          },
          "elevations_m_flat": {
            "items": {
              "type": "number"
            },
            "maxItems": 16384,
            "minItems": 16384,
            "title": "Elevations M Flat",
            "type": "array"
          },
          "extent_m": {
            "default": 40000.0,
            "title": "Extent M",
            "type": "number"
          },
          "frame": {
            "const": "local_enu",
            "default": "local_enu",
            "title": "Frame",
            "type": "string"
          },
          "grid_size": {
            "const": 128,
            "default": 128,
            "title": "Grid Size",
            "type": "integer"
          },
          "horizons": {
            "items": {
              "$ref": "#/components/schemas/HorizonProfileSchema"
            },
            "maxItems": 3,
            "minItems": 3,
            "title": "Horizons",
            "type": "array"
          },
          "max_elevation_m": {
            "title": "Max Elevation M",
            "type": "number"
          },
          "min_elevation_m": {
            "title": "Min Elevation M",
            "type": "number"
          },
          "model": {
            "const": "lola_80s_80m",
            "default": "lola_80s_80m",
            "title": "Model",
            "type": "string"
          },
          "psr_mask": {
            "title": "Psr Mask",
            "type": "null"
          },
          "row_direction": {
            "const": "south_to_north",
            "default": "south_to_north",
            "title": "Row Direction",
            "type": "string"
          },
          "site_id": {
            "title": "Site Id",
            "type": "string"
          },
          "slopes_deg_flat": {
            "items": {
              "type": "number"
            },
            "maxItems": 16384,
            "minItems": 16384,
            "title": "Slopes Deg Flat",
            "type": "array"
          },
          "spacing_m": {
            "default": 314.96062992125985,
            "title": "Spacing M",
            "type": "number"
          }
        },
        "required": [
          "site_id",
          "center_elevation_m",
          "min_elevation_m",
          "max_elevation_m",
          "elevations_m_flat",
          "slopes_deg_flat",
          "horizons"
        ],
        "title": "TerrainPatchSchema",
        "type": "object"
      },
      "TimeseriesPointSchema": {
        "description": "Single UTC timestep sample of Sun, Earth, power, and countdown state.",
        "properties": {
          "earth_az_deg": {
            "title": "Earth Az Deg",
            "type": "number"
          },
          "earth_clearance_deg": {
            "title": "Earth Clearance Deg",
            "type": "number"
          },
          "earth_elev_deg": {
            "title": "Earth Elev Deg",
            "type": "number"
          },
          "earth_horizon_elev_deg": {
            "title": "Earth Horizon Elev Deg",
            "type": "number"
          },
          "hours_to_next_earthrise": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Next Earthrise"
          },
          "hours_to_next_earthset": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Next Earthset"
          },
          "hours_to_next_sunrise": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Next Sunrise"
          },
          "hours_to_next_sunset": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours To Next Sunset"
          },
          "is_dte_geometric": {
            "title": "Is Dte Geometric",
            "type": "boolean"
          },
          "is_dte_visible": {
            "title": "Is Dte Visible",
            "type": "boolean"
          },
          "is_solar_conjunction": {
            "title": "Is Solar Conjunction",
            "type": "boolean"
          },
          "is_sunlit": {
            "title": "Is Sunlit",
            "type": "boolean"
          },
          "solar_power_factor": {
            "title": "Solar Power Factor",
            "type": "number"
          },
          "sun_az_deg": {
            "title": "Sun Az Deg",
            "type": "number"
          },
          "sun_earth_sep_deg": {
            "title": "Sun Earth Sep Deg",
            "type": "number"
          },
          "sun_elev_deg": {
            "title": "Sun Elev Deg",
            "type": "number"
          },
          "sun_horizon_elev_deg": {
            "title": "Sun Horizon Elev Deg",
            "type": "number"
          },
          "sun_visible_fraction": {
            "title": "Sun Visible Fraction",
            "type": "number"
          },
          "timestamp_utc": {
            "title": "Timestamp Utc",
            "type": "string"
          }
        },
        "required": [
          "timestamp_utc",
          "sun_az_deg",
          "sun_elev_deg",
          "sun_horizon_elev_deg",
          "sun_visible_fraction",
          "is_sunlit",
          "solar_power_factor",
          "earth_az_deg",
          "earth_elev_deg",
          "earth_horizon_elev_deg",
          "earth_clearance_deg",
          "is_dte_geometric",
          "is_solar_conjunction",
          "is_dte_visible",
          "sun_earth_sep_deg"
        ],
        "title": "TimeseriesPointSchema",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",

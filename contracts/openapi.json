  "info": {
    "description": "Clean-architecture lunar solar illumination, DTE comms, and terrain API.",
    "title": "Lunar Landing Site Navigator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/evaluate": {
      "post": {
        "description": "Evaluate illumination, DTE comms, countdowns, and score for a scenario.",
        "operationId": "evaluate_scenario_endpoint_api_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponseSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate Scenario Endpoint",
        "tags": [
          "evaluate"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Return service liveness, coordinate frame, and reference constants.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/sites": {
      "get": {
        "description": "Return the 16 curated sites in registry order.",
        "operationId": "list_sites_endpoint_api_v1_sites_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteSummarySchema"
                  },
                  "title": "Response List Sites Endpoint Api V1 Sites Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sites Endpoint",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}/terrain": {
      "get": {
        "description": "Return a LOLA terrain patch, or 404/409 for unknown or limb-only sites.",
        "operationId": "get_site_terrain_api_v1_sites__site_id__terrain_get",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "title": "Site Id",
              "type": "string"
            }

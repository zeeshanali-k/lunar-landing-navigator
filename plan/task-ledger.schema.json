{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunar-landing.spaceapps/schemas/task-ledger.schema.json",
  "title": "Lunar Landing Site Navigator Task Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement_anchors", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "requirement_anchors": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^REQ-(0[1-9]|1[0-2])$" },
      "description": "Exactly REQ-01 .. REQ-12 in order, as defined by HACKATHON_BUILD_PLAN.md."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "phase", "priority", "owner", "reviewer", "status",
        "depends_on", "requirement_ids", "working_directory", "read_paths",
        "write_paths", "inputs", "outputs", "commands", "acceptance",
        "required_evidence", "evidence", "human_approval_required", "approval",
        "blocked_reason", "completed_at_utc", "completed_commit"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$" },
        "title": { "type": "string", "minLength": 8 },
        "phase": {
          "type": "string",
          "enum": ["planning", "foundation", "data", "backend", "frontend", "qa", "gate", "p1", "delivery"]
        },
        "priority": { "type": "string", "enum": ["P0", "P1", "delivery"] },
        "owner": { "type": "string", "enum": ["A", "B", "both"] },
        "reviewer": { "type": "string", "enum": ["A", "B", "human"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "done"] },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$" }
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^REQ-(0[1-9]|1[0-2])$" }
        },
        "working_directory": { "type": "string", "minLength": 1 },
        "read_paths": { "type": "array", "items": { "type": "string" } },
        "write_paths": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwd", "run", "expected_exit"],
            "properties": {
              "cwd": { "type": "string", "minLength": 1 },
              "run": { "type": "string", "minLength": 1 },
              "expected_exit": { "type": "integer" }
            }
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["command", "artifact", "approval", "report"] },
              "ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["command", "artifact", "approval", "report"] },
              "ref": { "type": "string" },
              "exit": { "type": "integer" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "note": { "type": "string" }
            }
          }
        },
        "human_approval_required": { "type": "boolean" },
        "approval": { "type": ["string", "null"] },
        "blocked_reason": { "type": ["string", "null"] },
        "completed_at_utc": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "completed_commit": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] },
          "then": {
            "properties": {
              "completed_at_utc": { "type": "string" },
              "completed_commit": { "type": "string", "minLength": 7 },
              "blocked_reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
          "then": { "properties": { "blocked_reason": { "type": "string", "minLength": 10 } } }
        },
        {
          "if": { "properties": { "human_approval_required": { "const": true } }, "required": ["human_approval_required"] },
          "then": { "properties": { "reviewer": { "const": "human" } } }
        }
      ]
    }
  }
}
